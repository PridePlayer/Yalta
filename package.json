{
  "name": "yalta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --external:ws --outfile=server-dist/index.cjs && node server-dist/index.cjs",
    "build:server": "esbuild server/src/index.ts --bundle --platform=node --format=cjs --external:ws --outfile=server-dist/index.cjs"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
